<Project>
    <PropertyGroup>
        <TargetGameName>Firestone</TargetGameName>
        <IsMacOS>$([MSBuild]::IsOSPlatform('OSX'))</IsMacOS>
        <GameRoot Condition="'$(COMMON_DIR)' != ''">$(COMMON_DIR)\$(TargetGameName)</GameRoot>
        <GameRoot Condition="'$(GameRoot)' == '' and '$(IsMacOS)' == 'true'">$(HOME)/Library/Application Support/Steam/steamapps/common/$(TargetGameName)</GameRoot>
        <GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\$(TargetGameName)</GameRoot>
    </PropertyGroup>

    <!--
        The Windows build of Firestone is IL2CPP; the macOS build is Mono.
        GameRuntime picks the matching references and defines MONO for the Mono build.
        Override with -p:GameRuntime=Il2Cpp or -p:GameRuntime=Mono.
    -->
    <PropertyGroup>
        <GameRuntime Condition="'$(GameRuntime)' == '' and '$(IsMacOS)' == 'true'">Mono</GameRuntime>
        <GameRuntime Condition="'$(GameRuntime)' == ''">Il2Cpp</GameRuntime>
    </PropertyGroup>

    <PropertyGroup>
        <MelonLoaderDir>$(GameRoot)\MelonLoader</MelonLoaderDir>
        <ModsDir>$(GameRoot)\Mods</ModsDir>
        <UserLibsDir>$(GameRoot)\UserLibs</UserLibsDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GameRuntime)' == 'Il2Cpp'">
        <MelonLoaderNetDir>$(MelonLoaderDir)\net6</MelonLoaderNetDir>
        <Il2CppAssembliesDir>$(MelonLoaderDir)\Il2CppAssemblies</Il2CppAssembliesDir>
        <GameAssembliesDir>$(Il2CppAssembliesDir)</GameAssembliesDir>
        <TargetFramework>net6.0</TargetFramework>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GameRuntime)' == 'Mono'">
        <MelonLoaderNetDir>$(MelonLoaderDir)/net35</MelonLoaderNetDir>
        <GameAssembliesDir>$(GameRoot)/$(TargetGameName).app/Contents/Resources/Data/Managed</GameAssembliesDir>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>latest</LangVersion>
        <DefineConstants>$(DefineConstants);MONO</DefineConstants>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <PropertyGroup>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    </PropertyGroup>
</Project>